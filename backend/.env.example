# Required for running the API locally. This file is a template, not a source of secrets.
DATABASE_URL=jdbc:mysql://localhost:3306/db_DevPulse?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace-with-your-mysql-root-password
# A random, base64-encoded value that decodes to at least 32 bytes. Generate it locally;
# never commit the generated value.
JWT_SECRET=generate-a-base64-secret-with-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:5173
# Create an OAuth App at https://github.com/settings/developers with this callback URL:
# http://localhost:8080/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
GITHUB_FRONTEND_SUCCESS_URL=http://localhost:5173/app/dashboard
# A random, base64-encoded value that decodes to exactly 32 bytes (AES-256). Generate it locally;
# never commit the generated value. Existing connected GitHub accounts must reconnect after this
# is set/changed, since their stored tokens were encrypted with a different (or no) key.
TOKEN_ENCRYPTION_KEY=generate-a-base64-secret-that-decodes-to-32-bytes
# Create a free key (no card required) at https://aistudio.google.com
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Seeds a read-only sample team and enables "Try the live demo" (POST /api/v1/auth/demo).
DEMO_ENABLED=false
ADMIN_EMAILS=
AUTO_SYNC_ENABLED=true

# Optional: SMTP for the weekly digest. Leave MAIL_HOST blank to send no email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
