# Required for running the API locally. This file is a template, not a source of secrets.
DATABASE_URL=jdbc:postgresql://localhost:5432/devpulse
DATABASE_USERNAME=devpulse
DATABASE_PASSWORD=replace-with-your-local-password
# A random, base64-encoded value that decodes to at least 32 bytes. Generate it locally;
# never commit the generated value.
JWT_SECRET=generate-a-base64-secret-with-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:5173
# Create an OAuth App at https://github.com/settings/developers with this callback URL:
# http://localhost:8080/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
GITHUB_FRONTEND_SUCCESS_URL=http://localhost:5173/integrations/github
